# Gateway 自身
CCC_ROUTER_TOKEN=replace-with-router-bearer-token
PORT=8787
HOST=127.0.0.1

# 上游 secrets（强制 BYOK，忽略 client token）
CCC_MINIMAX_AUTH_TOKEN=replace-with-minimax-token
CCC_GLM_AUTH_TOKEN=replace-with-glm-token

# 可选：覆盖内置路由表（JSON 数组，与默认表合并）
# CCC_ROUTES='[{"aliases":["new-model"],"baseUrl":"https://example.com","secret":"CCC_X_TOKEN","upstreamId":"real-id"}]'
